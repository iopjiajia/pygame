import pygame
import sys

class AlienCharacter:
    """Class that handles drawing a bitmap character at the center of the screen."""
    def __init__(self, center_x, center_y, scale=10):
        # Define a 16x16 Space Invader style alien using a list of strings
        self.pixel_data = [
            "0000011111100000",
            "0000111111110000",
            "0001111111111000",
            "0011100110011100",
            "0011111111111100",
            "0001111111111000",
            "0000100000010000",
            "0001100000011000",
            "0011110000111100",
            "0111111001111110",
            "0110011111100110",
            "0110011111100110",
            "0110001111000110",
            "0011000000001100",
            "0001100000011000",
            "0000000000000000"
        ]
        
        # Create a transparent surface
        sprite_surface = pygame.Surface((16, 16), pygame.SRCALPHA)
        white = (255, 255, 255)
        
        # Draw the pixels onto the surface
        for y, row in enumerate(self.pixel_data):
            for x, pixel in enumerate(row):
                if pixel == '1':
                    sprite_surface.set_at((x, y), white)

        # Scale up the image
        scaled_size = (16 * scale, 16 * scale)
        self.image = pygame.transform.scale(sprite_surface, scaled_size)
        
        # Set the rect to center the character
        self.rect = self.image.get_rect(center=(center_x, center_y))

    def draw(self, surface):
        surface.blit(self.image, self.rect)

def main():
    # Initialize all imported pygame modules
    pygame.init()

    # Define constants for window size
    SCREEN_WIDTH = 800
    SCREEN_HEIGHT = 600
    
    # Define colors using RGB tuples
    # Dark blue background: R=20, G=20, B=40
    DARK_BLUE = (20, 20, 40)
    
    # Create the window display surface
    screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
    
    # Set the title of the window
    pygame.display.set_caption("Pixel Art Character")

    # Create the alien character instance at the center of the screen
    alien = AlienCharacter(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2)

    # Variable to keep the main loop running
    running = True

    # The main game loop handles events, updates state, and draws the screen
    while running:
        # Check for events in the event queue
        for event in pygame.event.get():
            # If the user clicks the 'X' button, stop the loop
            if event.type == pygame.QUIT:
                running = False

        # Fill the entire screen surface with the dark blue background
        screen.fill(DARK_BLUE)
        
        # Draw the character object to the screen
        alien.draw(screen)

        # Flip the display to update the window with the new drawings
        pygame.display.flip()

    # Uninitialize pygame and exit the system
    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
