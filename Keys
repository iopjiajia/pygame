import pygame
import sys

def main():
    # Initialize all imported pygame modules
    pygame.init()

    # Create an empty screen/window
    screen_width, screen_height = 640, 480
    screen = pygame.display.set_mode((screen_width, screen_height))
    pygame.display.set_caption("Pygame Key Event Detector")

    # Set up a clock to control the frame rate
    clock = pygame.time.Clock()

    print("Pygame is running! Click on the empty window, then press various keys.")
    print("Check your terminal/console to see the Pygame response.")
    print("-" * 60)

    # Main event loop
    running = True
    while running:
        for event in pygame.event.get():
            # Handle window closure
            if event.type == pygame.QUIT:
                running = False
            
            # Detect KEYDOWN events
            elif event.type == pygame.KEYDOWN:
                # Print the event.key attribute as requested
                # Also printing the key name for easier reading!
                key_name = pygame.key.name(event.key)
                print(f"KEYDOWN detected! event.key: {event.key} | Key name: '{key_name}'")

        # Fill the screen with a solid color (dark grey)
        screen.fill((40, 40, 40))
        
        # Update the full display Surface to the screen
        pygame.display.flip()

        # Limit the frame rate to 60 frames per second
        clock.tick(60)

    # Clean up and exit
    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
